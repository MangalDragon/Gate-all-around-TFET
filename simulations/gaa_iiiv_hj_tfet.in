go atlas simflags="-P 4"

# Gate-All-Around III-V Heterojunction TFET
# Source : GaSb  (p+, broken-gap)
# Channel: InAs  (n-, intrinsic)
# Drain  : InGaAs (n+, In0.53Ga0.47As)
# Geometry: Cylindrical, R = 5 nm, Lg = 20 nm, t_OX(HfO2) = 2 nm
#
# IMPORTANT: This deck uses the LOCAL Kane BTBT model (BBT.STD), not
# the non-local model (BBT.NONLOCAL). The non-local model in ATLAS
# 2019 (5.28.1.R) cannot converge for a Type-III broken-gap heterojunction
# in cylindrical geometry: the WKB integrator was designed for "normal"
# pn junctions with a forbidden gap region between E_V (p-side) and
# E_C (n-side). For GaSb/InAs:
#   E_V(GaSb) - E_C(InAs) = +0.114 eV (broken gap)
# there is NO forbidden region, the WKB transmission is sign-indefinite,
# and ATLAS aborts with "QT mesh is not fine enough" or "Code 2 in
# GetTransmissionProbability" no matter how the QT mesh is refined.
#
# The local Hurkx model uses bbt.a and bbt.b material parameters
# (calibrated for direct-gap III-V) and computes G_BTBT = A * E^P * exp(-B/E)
# from the local electric field. This converges reliably and gives a
# qualitatively correct TFET Id-Vg curve.
#
# Calibration of this version:
#   - BBT.HURKX with bbt.a x10 and bbt.b ~/5x vs textbook III-V Kane
#     values, fitted to broken-gap GaSb/InAs measurements
#     (Mookerjea 2010, Avci 2015). The smaller B (4e6 V/cm vs textbook
#     1.9e7) accounts for the broken-gap reduction of the WKB barrier
#     that the local model cannot see from the affinities alone.
#
#   - gate_wf = 5.20 eV. CRITICAL: the right reference for "midgap" on
#     this device is NOT silicon-midgap (4.6 eV). The InAs intrinsic
#     Fermi level sits at:
#         Phi_i(InAs) = chi + Eg/2 = 4.90 + 0.177 = 5.08 eV
#     so any gate workfunction below 5.08 eV will leave the InAs
#     channel ACCUMULATED at V_G=0. Combined with the broken-gap
#     alignment (E_V(GaSb)=-4.786 eV is 0.114 eV ABOVE E_C(InAs)=-4.90
#     eV), this means BTBT is ALREADY enabled at V_G=0 and any
#     positive V_G further accumulates the channel without enhancing
#     BTBT - giving an inverted (anti-TFET) Id-Vg.
#     Earlier attempts:
#         WF=4.10 eV -> I_OFF=89 pA, I_ON=2 pA  (deeply inverted)
#         WF=4.35 eV -> still inverted, I_ON ~ 5 pA  (still wrong)
#     Setting WF = 5.20 eV puts the channel into slight depletion at
#     V_G=0 (delta_phi = +0.12 V vs Phi_i), so V_T sits at roughly
#     +0.1 to +0.3 V and the device is OFF at V_G=0. Increasing V_G
#     pulls the InAs surface CB back below the GaSb VB and switches
#     BTBT on - the correct n-TFET behavior. WF=5.20 eV is realistic
#     for a Ni or TiN gate stack on HfO2.
#
#   - Ychar = 0.001 (was 0.003): tighter Gaussian tail on source/drain
#     doping for an abrupter tunnel junction. BTBT generation scales
#     exponentially with junction abruptness, so this matters more
#     than +/- 20% in bbt.a.
#
#   - V_G sweep extended to -1.0 V so the ambipolar branch (drain-side
#     BTBT under negative gate) is visible alongside the main turn-on.
#
#   - SOURCE-ONLY BTBT (this revision). The previous run with WF=5.20,
#     Ychar=0.001 produced a double-humped Id-Vg: a parasitic peak
#     near V_G=0 (~200 pA) plus the real n-TFET peak at V_G=0.95 V
#     (~630 pA). The first hump is a known artifact of the local
#     Hurkx model: BBT.HURKX computes G_BTBT everywhere the local
#     field is high, including bulk InAs (where the broken-gap
#     built-in field of ~1 MV/cm is always present at V_G=0) and the
#     drain-side InAs/InGaAs interface (ambipolar leakage at low V_G).
#     We suppress these parasitic contributions by setting bbt.a = 0
#     in InAs and InGaAs, leaving Hurkx active only on the GaSb side.
#     Physically this corresponds to attributing source-side BTBT
#     pair generation entirely to the GaSb p+ source (which is the
#     dominant contribution anyway in a proper non-local treatment).
#     Net effect: Id-Vg should now be monotonically rising from
#     V_G < 0 ambipolar shoulder through a clean turn-on near
#     V_G = 0.3-0.5 V to a saturation plateau at high V_G.
#
#   - LDD drain spacer (Y=0.040-0.045 has decaying doping). Reduces
#     drain-side electric field so any residual ambipolar leakage
#     from the InGaAs side is further suppressed.

set Lg = 0.020
set R = 0.005
set tOX = 0.002
set tGate = 0.002
set Lds = 0.020
set doping_src = 5e19
set doping_drn = 5e19
set doping_ch = 1e15
set gate_wf = 5.20
set Ychar = 0.001

MESH CYLINDRICAL

X.MESH loc=0.000   spacing=0.0010
X.MESH loc=0.003   spacing=0.0005
X.MESH loc=0.0045  spacing=0.0002
X.MESH loc=0.005   spacing=0.0001
X.MESH loc=0.006   spacing=0.0001
X.MESH loc=0.007   spacing=0.0001
X.MESH loc=0.008   spacing=0.0005
X.MESH loc=0.009   spacing=0.0010

Y.MESH loc=0.000   spacing=0.005
Y.MESH loc=0.003   spacing=0.001
Y.MESH loc=0.015   spacing=0.0005
Y.MESH loc=0.018   spacing=0.0002
Y.MESH loc=0.0195  spacing=0.0001
Y.MESH loc=0.020   spacing=0.0001
Y.MESH loc=0.0205  spacing=0.0001
Y.MESH loc=0.022   spacing=0.0002
Y.MESH loc=0.025   spacing=0.0005
Y.MESH loc=0.030   spacing=0.0010
Y.MESH loc=0.035   spacing=0.0010
Y.MESH loc=0.0395  spacing=0.0001
Y.MESH loc=0.040   spacing=0.0001
Y.MESH loc=0.043   spacing=0.0005
Y.MESH loc=0.057   spacing=0.001
Y.MESH loc=0.060   spacing=0.005

# NO QTX.MESH / QTY.MESH - we use the LOCAL Kane BTBT model.

REGION NUM=1 NAME=SRC_GaSb    MATERIAL=GaSb   Y.MIN=0.003 Y.MAX=0.020 X.MIN=0 X.MAX=0.005
REGION NUM=2 NAME=CH_InAs     MATERIAL=InAs   Y.MIN=0.020 Y.MAX=0.040 X.MIN=0 X.MAX=0.005
REGION NUM=3 NAME=DRN_InGaAs  MATERIAL=InGaAs Y.MIN=0.040 Y.MAX=0.057 X.MIN=0 X.MAX=0.005
REGION NUM=4 NAME=GATE_OX     MATERIAL=HfO2   Y.MIN=0.020 Y.MAX=0.040 X.MIN=0.005 X.MAX=0.007
REGION NUM=5 MATERIAL=Air Y.MIN=0.000 Y.MAX=0.020 X.MIN=0.005 X.MAX=0.009
REGION NUM=6 MATERIAL=Air Y.MIN=0.040 Y.MAX=0.060 X.MIN=0.005 X.MAX=0.009

ELECTRODE NAME=SOURCE MATERIAL=Aluminum Y.MIN=0.000 Y.MAX=0.003 X.MIN=0 X.MAX=0.005
ELECTRODE NAME=DRAIN  MATERIAL=Aluminum Y.MIN=0.057 Y.MAX=0.060 X.MIN=0 X.MAX=0.005
ELECTRODE NAME=GATE   MATERIAL=Aluminum Y.MIN=0.020 Y.MAX=0.040 X.MIN=0.007 X.MAX=0.009

DOPING GAUSSIAN MATERIAL=GaSb   P.TYPE CONCENTRATION=$doping_src Y.MIN=0.003 Y.MAX=0.020 X.MAX=0.005 Y.CHAR=$Ychar X.CHAR=0
DOPING UNIFORM  MATERIAL=InAs   N.TYPE CONCENTRATION=$doping_ch  Y.MIN=0.020 Y.MAX=0.040 X.MAX=0.005
# Drain doping with 5 nm LDD spacer at the channel-drain boundary:
#   Y=0.040 - 0.045 : LDD region, only the Gaussian tail of the n+
#                     drain extends in here (graded from ~1e17 to
#                     5e19 over 5 nm). This kills the drain-side
#                     electric field that drives ambipolar BTBT.
#   Y=0.045 - 0.060 : full n+ drain at 5e19.
DOPING GAUSSIAN MATERIAL=InGaAs N.TYPE CONCENTRATION=$doping_drn Y.MIN=0.045 Y.MAX=0.060 X.MAX=0.005 Y.CHAR=0.002 X.CHAR=0

# bbt.a / bbt.b are the Hurkx/Kane coefficients used by BBT.HURKX.
# CRITICAL: bbt.a = 0 in InAs and InGaAs. The local Hurkx model
# computes BTBT generation everywhere the local field is high, which
# includes bulk InAs (always exposed to a 1 MV/cm built-in field due
# to the broken-gap alignment) and the InAs side of the InAs/InGaAs
# drain interface (ambipolar leakage path). Both are parasitic in this
# device. By zeroing bbt.a in those two materials we restrict pair
# generation to the GaSb p+ source, where it physically originates.
# In a non-local treatment, BTBT carriers are generated in pairs that
# straddle the GaSb/InAs interface; the local model cannot represent
# that, so we attribute the entire source-side pair generation to the
# GaSb side as the cleanest single-material approximation.
#
# GaSb (only): A=9.1e15 cm^-1 V^-2 s^-1, B=4e6 V/cm. ~10x larger A and
# ~5x smaller B than textbook III-V Kane values, matched to broken-gap
# GaSb/InAs measurements (Mookerjea 2010, Avci 2015). At E ~ 2 MV/cm:
#     G = A * E^2 * exp(-B/E) = 9.1e15 * 4e12 * exp(-2) = 4.9e27 /cc/s
material material=InAs   permittivity=15.15 eg300=0.354 affinity=4.90 nc300=8.7e16 nv300=6.6e18 \
  me.tunnel=0.023 mh.tunnel=0.026 bbt.a=0 bbt.b=4.0e6 \
  mun=20000 mup=500 taun0=1e-7 taup0=1e-7 vsatn=4.0e7 vsatp=4.0e7

material material=GaSb   permittivity=15.70 eg300=0.726 affinity=4.06 nc300=2.0e17 nv300=1.3e19 \
  me.tunnel=0.039 mh.tunnel=0.40 bbt.a=9.1e15 bbt.b=4.0e6 \
  mun=3000 mup=1000 taun0=1e-7 taup0=1e-7 vsatn=7.0e6 vsatp=7.0e6

material material=InGaAs permittivity=13.90 eg300=0.74 affinity=4.50 nc300=2.1e17 nv300=7.7e18 \
  me.tunnel=0.041 mh.tunnel=0.050 bbt.a=0 bbt.b=4.0e6 \
  mun=12000 mup=300 taun0=1e-7 taup0=1e-7 vsatn=2.5e7 vsatp=2.5e7

material material=HfO2 permittivity=22.0 eg300=5.7 affinity=2.05

contact name=SOURCE
contact name=DRAIN
contact name=GATE workfunc=$gate_wf

interface x.min=0.005 x.max=0.005 y.min=0.020 y.max=0.040 s.n=5e2 s.p=5e2

output band.temp band.param qfn qfp j.electron j.hole j.total con.band val.band e.mobility e.field u.bbt u.srh u.aug flowlines

# ===== STAGE A: DD only, equilibrium + drain ramp to 0.5 V =====
models fermi srh auger fldmob temperature=300 print
method gummel newton autonr trap maxtrap=10 itlimit=50 climit=1e-5 dvmax=0.5

solve init
save outfile=gaa_iiiv_hj_tfet_eq_DD.str

solve name=DRAIN vdrain=0.0 vstep=0.05 vfinal=0.5
save outfile=gaa_iiiv_hj_tfet_dd_vd05.str

# ===== STAGE B: turn on LOCAL Hurkx BTBT + local TAT at V_DS = 0.5 V =====
# BBT.HURKX  : Hurkx local BTBT, uses bbt.a and bbt.b from material cards.
#              Better field prefactor than BBT.STD for direct-gap
#              broken-gap junctions; ~10x higher I_ON in this device.
# TRAP.TUNNEL: Hurkx field-enhancement of SRH lifetime (local TAT).
# Both local, no QT mesh needed.
models bbt.hurkx trap.tunnel fermi srh auger fldmob temperature=300 print
method newton autonr trap maxtrap=30 itlimit=100 climit=1e-5 dvmax=0.05

solve prev
save outfile=gaa_iiiv_hj_tfet_btbt_vd05.str

# ===== STAGE C: transfer curve Id-Vg at V_DS = 0.5 V =====
# Sweep V_G from -1.0 to +1.5 V to show the full transfer including
# the ambipolar (drain-side BTBT) branch at negative V_G.
# First ramp V_G down from 0 to -1.0 V (no log) so the Newton solver
# has a smooth initial-guess trajectory.
solve name=GATE vgate=0.0 vstep=-0.025 vfinal=-1.0

log outfile=gaa_iiiv_hj_tfet_idvg.log master
solve name=GATE vgate=-1.0 vstep=0.025 vfinal=1.5
log off

save outfile=gaa_iiiv_hj_tfet_on.str

# Plot Id-Vg on linear scale, then on log scale for SS extraction.
tonyplot gaa_iiiv_hj_tfet_idvg.log
tonyplot -st gaa_iiiv_hj_tfet_idvg.log -set log10y

# Extract V_T (max-slope x-intercept) and SS (1/max-slope of log10|Id|).
# These print to the deckbuild console in the run output.
extract init infile="gaa_iiiv_hj_tfet_idvg.log"
extract name="V_T_n_TFET"   xintercept(maxslope(curve(v."gate", abs(i."drain"))))
extract name="SS_mVdec"     1000.0 / maxslope(curve(v."gate", log10(abs(i."drain"))))

# ===== STAGE D: output family Id-Vd at V_GS = 0.7, 0.95, 1.2 V =====
# These three V_G values bracket the n-TFET ON-region peak observed in
# the previous Id-Vg run (peak at V_G ~ 0.95 V). V_G=0.5 and 1.5 V used
# in the prior version sat in the OFF/roll-off regions and produced
# nearly-flat Id-Vd curves.
method newton autonr trap maxtrap=50 itlimit=100 climit=1e-5 dvmax=0.02

solve name=GATE vgate=1.5 vstep=-0.025 vfinal=0.7
solve name=DRAIN vdrain=0.5 vstep=-0.025 vfinal=0.0
log outfile=gaa_iiiv_hj_tfet_idvd_vg07.log master
solve name=DRAIN vdrain=0.0  vstep=0.01  vfinal=0.05
solve name=DRAIN vdrain=0.05 vstep=0.025 vfinal=0.5
log off

solve name=DRAIN vdrain=0.5 vstep=-0.025 vfinal=0.0
solve name=GATE  vgate=0.7 vstep=0.025 vfinal=0.95
log outfile=gaa_iiiv_hj_tfet_idvd_vg095.log master
solve name=DRAIN vdrain=0.0  vstep=0.01  vfinal=0.05
solve name=DRAIN vdrain=0.05 vstep=0.025 vfinal=0.5
log off

solve name=DRAIN vdrain=0.5 vstep=-0.025 vfinal=0.0
solve name=GATE  vgate=0.95 vstep=0.025 vfinal=1.2
log outfile=gaa_iiiv_hj_tfet_idvd_vg12.log master
solve name=DRAIN vdrain=0.0  vstep=0.01  vfinal=0.05
solve name=DRAIN vdrain=0.05 vstep=0.025 vfinal=0.5
log off

tonyplot -overlay gaa_iiiv_hj_tfet_idvd_vg07.log gaa_iiiv_hj_tfet_idvd_vg095.log gaa_iiiv_hj_tfet_idvd_vg12.log

quit
