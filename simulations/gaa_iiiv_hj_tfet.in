go atlas simflags="-P 4"

set Lg = 0.020
set R = 0.005
set tOX = 0.002
set tGate = 0.002
set Lds = 0.020
set doping_src = 5e19
set doping_drn = 5e19
set doping_ch = 1e15
set gate_wf = 4.35
set Ychar = 0.003

MESH CYLINDRICAL

X.MESH loc=0.000   spacing=0.0010
X.MESH loc=0.003   spacing=0.0005
X.MESH loc=0.0045  spacing=0.0002
X.MESH loc=0.005   spacing=0.0001
X.MESH loc=0.006   spacing=0.0001
X.MESH loc=0.007   spacing=0.0001
X.MESH loc=0.008   spacing=0.0005
X.MESH loc=0.009   spacing=0.0010

Y.MESH loc=0.000   spacing=0.005
Y.MESH loc=0.003   spacing=0.001
Y.MESH loc=0.015   spacing=0.0005
Y.MESH loc=0.018   spacing=0.0002
Y.MESH loc=0.0195  spacing=0.0001
Y.MESH loc=0.020   spacing=0.0001
Y.MESH loc=0.0205  spacing=0.0001
Y.MESH loc=0.022   spacing=0.0002
Y.MESH loc=0.025   spacing=0.0005
Y.MESH loc=0.030   spacing=0.0010
Y.MESH loc=0.035   spacing=0.0010
Y.MESH loc=0.0395  spacing=0.0001
Y.MESH loc=0.040   spacing=0.0001
Y.MESH loc=0.043   spacing=0.0005
Y.MESH loc=0.057   spacing=0.001
Y.MESH loc=0.060   spacing=0.005

# QT mesh: tight 50 pm window ONLY +/- 1 nm around the junction (Y=0.020)
# Previous versions used 0.1 nm over 16 nm -> "mesh not fine enough"
# because the WKB path is only ~0.3 nm long at this broken-gap alignment.
QTX.MESH LOC=0.000  SPACING=0.0005
QTX.MESH LOC=0.0025 SPACING=0.0005
QTX.MESH LOC=0.005  SPACING=0.0005

QTY.MESH LOC=0.012  SPACING=0.002
QTY.MESH LOC=0.019  SPACING=0.0005
QTY.MESH LOC=0.0199 SPACING=0.00005
QTY.MESH LOC=0.020  SPACING=0.00005
QTY.MESH LOC=0.0201 SPACING=0.00005
QTY.MESH LOC=0.021  SPACING=0.0005
QTY.MESH LOC=0.028  SPACING=0.002

REGION NUM=1 NAME=SRC_GaSb    MATERIAL=GaSb   Y.MIN=0.003 Y.MAX=0.020 X.MIN=0 X.MAX=0.005
REGION NUM=2 NAME=CH_InAs     MATERIAL=InAs   Y.MIN=0.020 Y.MAX=0.040 X.MIN=0 X.MAX=0.005
REGION NUM=3 NAME=DRN_InGaAs  MATERIAL=InGaAs Y.MIN=0.040 Y.MAX=0.057 X.MIN=0 X.MAX=0.005
REGION NUM=4 NAME=GATE_OX     MATERIAL=HfO2   Y.MIN=0.020 Y.MAX=0.040 X.MIN=0.005 X.MAX=0.007
REGION NUM=5 MATERIAL=Air Y.MIN=0.000 Y.MAX=0.020 X.MIN=0.005 X.MAX=0.009
REGION NUM=6 MATERIAL=Air Y.MIN=0.040 Y.MAX=0.060 X.MIN=0.005 X.MAX=0.009

ELECTRODE NAME=SOURCE MATERIAL=Aluminum Y.MIN=0.000 Y.MAX=0.003 X.MIN=0 X.MAX=0.005
ELECTRODE NAME=DRAIN  MATERIAL=Aluminum Y.MIN=0.057 Y.MAX=0.060 X.MIN=0 X.MAX=0.005
ELECTRODE NAME=GATE   MATERIAL=Aluminum Y.MIN=0.020 Y.MAX=0.040 X.MIN=0.007 X.MAX=0.009

DOPING GAUSSIAN MATERIAL=GaSb   P.TYPE CONCENTRATION=$doping_src Y.MIN=0.003 Y.MAX=0.020 X.MAX=0.005 Y.CHAR=$Ychar X.CHAR=0
DOPING UNIFORM  MATERIAL=InAs   N.TYPE CONCENTRATION=$doping_ch  Y.MIN=0.020 Y.MAX=0.040 X.MAX=0.005
DOPING GAUSSIAN MATERIAL=InGaAs N.TYPE CONCENTRATION=$doping_drn Y.MIN=0.040 Y.MAX=0.060 X.MAX=0.005 Y.CHAR=$Ychar X.CHAR=0

material material=InAs   permittivity=15.15 eg300=0.354 affinity=4.90 nc300=8.7e16 nv300=6.6e18 me.tunnel=0.023 mh.tunnel=0.026 mun=20000 mup=500  taun0=1e-7 taup0=1e-7 vsatn=4.0e7 vsatp=4.0e7
material material=GaSb   permittivity=15.70 eg300=0.726 affinity=4.06 nc300=2.0e17 nv300=1.3e19 me.tunnel=0.039 mh.tunnel=0.40  mun=3000  mup=1000 taun0=1e-7 taup0=1e-7 vsatn=7.0e6 vsatp=7.0e6
material material=InGaAs permittivity=13.90 eg300=0.74  affinity=4.50 nc300=2.1e17 nv300=7.7e18 me.tunnel=0.041 mh.tunnel=0.050 mun=12000 mup=300  taun0=1e-7 taup0=1e-7 vsatn=2.5e7 vsatp=2.5e7
material material=HfO2   permittivity=22.0  eg300=5.7   affinity=2.05

contact name=SOURCE
contact name=DRAIN
contact name=GATE workfunc=$gate_wf

interface x.min=0.005 x.max=0.005 y.min=0.020 y.max=0.040 s.n=5e2 s.p=5e2

output band.temp band.param qfn qfp j.electron j.hole j.total con.band val.band e.mobility e.field u.srh u.aug flowlines

# ===== STAGE A: DD only, equilibrium + drain ramp to 0.5 V =====
models fermi srh auger fldmob temperature=300 print
method gummel newton autonr trap maxtrap=10 itlimit=50 climit=1e-5 dvmax=0.5

solve init
save outfile=gaa_iiiv_hj_tfet_eq_DD.str

solve name=DRAIN vdrain=0.0 vstep=0.05 vfinal=0.5
save outfile=gaa_iiiv_hj_tfet_dd_vd05.str

# ===== STAGE B: turn on BBT.NONLOCAL (without NLDERIVS first) =====
# First converge WITHOUT bbt.nlderivs to get a stable BTBT-aware solution.
# Then re-issue with nlderivs for the sweep.
models bbt.nonlocal fermi srh auger fldmob temperature=300 print
method newton autonr trap maxtrap=30 itlimit=100 climit=1e-5 dvmax=0.025

solve prev
save outfile=gaa_iiiv_hj_tfet_btbt_vd05.str

# Now add NLDERIVS for the sweep (Jacobian coupling)
models bbt.nonlocal bbt.nlderivs fermi srh auger fldmob temperature=300 print
method newton autonr trap maxtrap=30 itlimit=100 climit=1e-5 dvmax=0.025

solve prev

# ===== STAGE C: add TAT.NONLOCAL =====
models bbt.nonlocal bbt.nlderivs tat.nonlocal fermi srh auger fldmob temperature=300 print
method newton autonr trap maxtrap=30 itlimit=100 climit=1e-5 dvmax=0.025

solve prev
save outfile=gaa_iiiv_hj_tfet_full_vd05.str

# ===== STAGE D: transfer curve Id-Vg at Vd = 0.5 V =====
log outfile=gaa_iiiv_hj_tfet_idvg.log master
solve name=GATE vgate=0.0 vstep=0.025 vfinal=1.5
log off

save outfile=gaa_iiiv_hj_tfet_on.str
tonyplot gaa_iiiv_hj_tfet_idvg.log

# ===== STAGE E: output family Id-Vd =====
solve name=DRAIN vdrain=0.5 vstep=-0.025 vfinal=0.0

solve name=GATE vgate=1.5 vstep=-0.05 vfinal=0.5
log outfile=gaa_iiiv_hj_tfet_idvd_vg05.log master
solve name=DRAIN vdrain=0.0 vstep=0.025 vfinal=0.5
log off

solve name=DRAIN vdrain=0.5 vstep=-0.025 vfinal=0.0
solve name=GATE vgate=0.5 vstep=0.05 vfinal=1.0
log outfile=gaa_iiiv_hj_tfet_idvd_vg10.log master
solve name=DRAIN vdrain=0.0 vstep=0.025 vfinal=0.5
log off

solve name=DRAIN vdrain=0.5 vstep=-0.025 vfinal=0.0
solve name=GATE vgate=1.0 vstep=0.05 vfinal=1.5
log outfile=gaa_iiiv_hj_tfet_idvd_vg15.log master
solve name=DRAIN vdrain=0.0 vstep=0.025 vfinal=0.5
log off

tonyplot -overlay gaa_iiiv_hj_tfet_idvd_vg05.log gaa_iiiv_hj_tfet_idvd_vg10.log gaa_iiiv_hj_tfet_idvd_vg15.log

quit
