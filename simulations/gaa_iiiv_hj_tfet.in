#-----------------------------------------------------------------------------
# Gate-All-Around III-V Heterojunction Tunnel FET
# Source : GaSb  (p+, broken-gap)
# Channel: InAs  (n-, intrinsic)
# Drain  : InGaAs(n+, In0.53Ga0.47As)
# Geometry: Cylindrical, R = 5 nm, Lg = 20 nm, t_OX(HfO2) = 2 nm
#
# Physics: BBT.NONLOCAL + TAT.NONLOCAL + BQP (Bohm) + Fermi-Dirac
# Target : transfer (Id-Vg @ Vd=0.5) and output (Id-Vd @ Vg=0.5,1.0,1.5)
#
# Reference targets at Vd = 0.5 V, room T:
#   Ion ~ 100 - 800 uA/um (effective perimeter)
#   Ioff ~ 1e-5 - 1e-3 nA/um
#   SS_min ~ 30 - 80 mV/dec (BTBT-limited, with TAT)
#   Vt around 0.2 - 0.5 V depending on confinement & gate WF
#-----------------------------------------------------------------------------
go atlas

#-- Geometry knobs (microns) -------------------------------------------------
set Lg         = 0.020
set R          = 0.005
set tOX        = 0.002
set tGate      = 0.002
set Lds        = 0.020
set doping_src = 5e19
set doping_drn = 5e19
set doping_ch  = 1e15
set gate_wf    = 4.35
set Ychar      = 0.003

#-----------------------------------------------------------------------------
# 1. MESH (cylindrical: X=radial, Y=axial)
#-----------------------------------------------------------------------------
MESH CYLINDRICAL

# Radial mesh: refine through channel, oxide, contact ring
X.MESH loc=0.000   spacing=0.0010
X.MESH loc=0.003   spacing=0.0005
X.MESH loc=0.0045  spacing=0.0002
X.MESH loc=0.005   spacing=0.0001     # channel/oxide interface
X.MESH loc=0.006   spacing=0.0001
X.MESH loc=0.007   spacing=0.0001     # oxide/gate interface
X.MESH loc=0.008   spacing=0.0005
X.MESH loc=0.009   spacing=0.0010

# Axial mesh: very fine across the source/channel tunnel junction (Y=0.020)
# and across drain/channel junction (Y=0.040)
Y.MESH loc=0.000   spacing=0.005
Y.MESH loc=0.003   spacing=0.001
Y.MESH loc=0.017   spacing=0.0005
Y.MESH loc=0.0195  spacing=0.0001
Y.MESH loc=0.020   spacing=0.0001     # source/channel tunnel junction
Y.MESH loc=0.025   spacing=0.0010
Y.MESH loc=0.030   spacing=0.0010
Y.MESH loc=0.035   spacing=0.0010
Y.MESH loc=0.0395  spacing=0.0001
Y.MESH loc=0.040   spacing=0.0001     # channel/drain junction
Y.MESH loc=0.043   spacing=0.0005
Y.MESH loc=0.057   spacing=0.001
Y.MESH loc=0.060   spacing=0.005

#-- Non-local BTBT/TAT mesh, ONLY at the source/channel tunnel junction ------
# Limiting QTREGION to the source side avoids drain-side ambipolar BTBT
# being captured into the same non-local mesh.
QTX.MESH LOC=0.000 SPACING=0.001
QTX.MESH LOC=0.005 SPACING=0.001

QTY.MESH LOC=0.015 SPACING=0.0005
QTY.MESH LOC=0.020 SPACING=0.0001
QTY.MESH LOC=0.025 SPACING=0.0005

#-----------------------------------------------------------------------------
# 2. REGIONS
#-----------------------------------------------------------------------------
REGION NUM=1 NAME=SRC_GaSb    MATERIAL=GaSb   \
  Y.MIN=0.003 Y.MAX=0.020     X.MIN=0 X.MAX=0.005

REGION NUM=2 NAME=CH_InAs     MATERIAL=InAs   \
  Y.MIN=0.020 Y.MAX=0.040     X.MIN=0 X.MAX=0.005

REGION NUM=3 NAME=DRN_InGaAs  MATERIAL=InGaAs \
  Y.MIN=0.040 Y.MAX=0.057     X.MIN=0 X.MAX=0.005

REGION NUM=4 NAME=GATE_OX     MATERIAL=HfO2   \
  Y.MIN=0.020 Y.MAX=0.040     X.MIN=0.005 X.MAX=0.007

REGION NUM=5 MATERIAL=Air \
  Y.MIN=0.000 Y.MAX=0.020     X.MIN=0.005 X.MAX=0.009

REGION NUM=6 MATERIAL=Air \
  Y.MIN=0.040 Y.MAX=0.060     X.MIN=0.005 X.MAX=0.009

#-----------------------------------------------------------------------------
# 3. ELECTRODES
#-----------------------------------------------------------------------------
ELECTRODE NAME=SOURCE MATERIAL=Aluminum \
  Y.MIN=0.000 Y.MAX=0.003     X.MIN=0 X.MAX=0.005

ELECTRODE NAME=DRAIN  MATERIAL=Aluminum \
  Y.MIN=0.057 Y.MAX=0.060     X.MIN=0 X.MAX=0.005

ELECTRODE NAME=GATE   MATERIAL=Aluminum \
  Y.MIN=0.020 Y.MAX=0.040     X.MIN=0.007 X.MAX=0.009

#-----------------------------------------------------------------------------
# 4. DOPING (graded source, uniform channel, graded drain)
#-----------------------------------------------------------------------------
DOPING GAUSSIAN MATERIAL=GaSb P.TYPE CONCENTRATION=$doping_src \
  Y.MIN=0.003 Y.MAX=0.020 X.MAX=0.005 \
  Y.CHAR=$Ychar X.CHAR=0

DOPING UNIFORM  MATERIAL=InAs N.TYPE CONCENTRATION=$doping_ch \
  Y.MIN=0.020 Y.MAX=0.040 X.MAX=0.005

DOPING GAUSSIAN MATERIAL=InGaAs N.TYPE CONCENTRATION=$doping_drn \
  Y.MIN=0.040 Y.MAX=0.060 X.MAX=0.005 \
  Y.CHAR=$Ychar X.CHAR=0

#-----------------------------------------------------------------------------
# 5. MATERIALS
#    Reference: Vurgaftman 2001 (band parameters), Bahuguna 2017 / Avci 2015
#    (tunneling masses), Mookerjea 2010 (broken-gap GaSb/InAs alignment).
#    NOTE: bbt.a / bbt.b are LOCAL Kane parameters and are inert when
#    BBT.NONLOCAL is selected. They are NOT included here on purpose.
#    The non-local model uses me.tunnel / mh.tunnel + Eg + affinity.
#-----------------------------------------------------------------------------
material material=InAs              \
  permittivity=15.15                \
  eg300=0.354    affinity=4.90      \
  nc300=8.7e16   nv300=6.6e18       \
  me.tunnel=0.023 mh.tunnel=0.026   \
  mun=20000      mup=500            \
  taun0=1e-9     taup0=1e-9         \
  vsatn=4.0e7    vsatp=4.0e7

material material=GaSb              \
  permittivity=15.70                \
  eg300=0.726    affinity=4.06      \
  nc300=2.0e17   nv300=1.3e19       \
  me.tunnel=0.039 mh.tunnel=0.40    \
  mun=3000       mup=1000           \
  taun0=1e-9     taup0=1e-9         \
  vsatn=7.0e6    vsatp=7.0e6

material material=InGaAs            \
  permittivity=13.90                \
  eg300=0.74     affinity=4.50      \
  nc300=2.1e17   nv300=7.7e18       \
  me.tunnel=0.041 mh.tunnel=0.050   \
  mun=12000      mup=300            \
  taun0=1e-9     taup0=1e-9         \
  vsatn=2.5e7    vsatp=2.5e7

# HfO2: high-k gate dielectric. eps_r ~ 21-25 typical.
material material=HfO2 permittivity=22.0 eg300=5.7 affinity=2.05

#-----------------------------------------------------------------------------
# 6. CONTACTS
#-----------------------------------------------------------------------------
contact name=SOURCE
contact name=DRAIN
contact name=GATE workfunc=$gate_wf

#-----------------------------------------------------------------------------
# 7. INTERFACE TRAPS (HfO2 / InAs)
#    Surface recombination + finite Dit-equivalent surface velocity drives
#    the realistic SS-floor through TAT.NONLOCAL (next section).
#-----------------------------------------------------------------------------
interface x.min=0.005 x.max=0.005 \
          y.min=0.020 y.max=0.040 \
          s.n=5e2 s.p=5e2

#-----------------------------------------------------------------------------
# 8. PHYSICS MODELS
#    See docs/MODELS.md for the rationale per flag.
#-----------------------------------------------------------------------------
# Stage A: equilibrium-friendly model set (no tunneling generation yet)
models                              \
  fermi                             \
  srh auger                         \
  fldmob                            \
  temperature=300                   \
  print

#-----------------------------------------------------------------------------
# 9. NUMERICAL METHOD (robust path)
#    Gummel for the first few solves, then full Newton with AUTONR.
#-----------------------------------------------------------------------------
method gummel newton autonr trap maxtrap=10 \
       itlimit=50 climit=1e-5 dvmax=0.5

#-- output what we want to inspect later -------------------------------------
output band.temp band.param  \
  qfn qfp                    \
  j.electron j.hole j.total  \
  con.band val.band          \
  e.mobility e.field         \
  u.bbt u.srh u.aug          \
  flowlines

#-----------------------------------------------------------------------------
# 10. EQUILIBRIUM SOLVE (drift-diffusion only, no BTBT yet)
#-----------------------------------------------------------------------------
solve init
save outfile=gaa_iiiv_hj_tfet_eq_DD.str

#-----------------------------------------------------------------------------
# 11. TURN ON FULL TFET PHYSICS
#     - BBT.NONLOCAL  : non-local interband tunneling on QTX/QTY mesh
#     - BBT.NLDERIVS  : Jacobian terms of G_BTBT (essential for Newton)
#     - TAT.NONLOCAL  : non-local trap-assisted tunneling
#     - BQP.N / BQP.P : Bohm Quantum Potential -> sub-band shift in 5 nm wire
#-----------------------------------------------------------------------------
models                              \
  bbt.nonlocal bbt.nlderivs         \
  tat.nonlocal                      \
  bqp.n bqp.p                       \
  fermi                             \
  srh auger                         \
  fldmob                            \
  temperature=300                   \
  print

# BQP calibration constants (Silvaco BQP note: gamma=1.4, alpha=0.3 fits Si
# Schroedinger-Poisson; for InAs nanowire similar values reproduce the
# 1st sub-band shift to within ~20 meV. Treat as a fit knob if you have
# atomistic reference data.)
material material=InAs   gamma.n=1.4  alpha.n=0.3  gamma.p=1.4  alpha.p=0.3
material material=GaSb   gamma.n=1.4  alpha.n=0.3  gamma.p=1.4  alpha.p=0.3
material material=InGaAs gamma.n=1.4  alpha.n=0.3  gamma.p=1.4  alpha.p=0.3

method newton autonr trap maxtrap=30 itlimit=100 climit=1e-5 dvmax=0.2

# warm-start with full physics
solve prev
save outfile=gaa_iiiv_hj_tfet_eq.str

#-----------------------------------------------------------------------------
# 12. TRANSFER CURVE: Id-Vg at Vd = 0.5 V
#-----------------------------------------------------------------------------
# Ramp drain first (small steps near zero, larger after)
solve name=DRAIN vdrain=0.0 vstep=0.01  vfinal=0.05
solve name=DRAIN vdrain=0.05 vstep=0.05 vfinal=0.50

log outfile=gaa_iiiv_hj_tfet_idvg.log master
solve name=GATE  vgate=0.0  vstep=0.025 vfinal=1.5
log off

save outfile=gaa_iiiv_hj_tfet_on.str
tonyplot gaa_iiiv_hj_tfet_idvg.log

#-----------------------------------------------------------------------------
# 13. OUTPUT FAMILY: Id-Vd at Vg = 0.5, 1.0, 1.5 V
#-----------------------------------------------------------------------------
# reset to the full-physics equilibrium
solve init
solve prev

# --- Vg = 0.5 V ------------------------------------------------------------
solve name=GATE  vgate=0.0 vstep=0.05 vfinal=0.5
solve name=DRAIN vdrain=0.0
log outfile=gaa_iiiv_hj_tfet_idvd_vg05.log master
solve name=DRAIN vdrain=0.0 vstep=0.025 vfinal=0.5
log off

# --- Vg = 1.0 V ------------------------------------------------------------
solve name=DRAIN vdrain=0.0
solve name=GATE  vgate=0.5 vstep=0.05 vfinal=1.0
log outfile=gaa_iiiv_hj_tfet_idvd_vg10.log master
solve name=DRAIN vdrain=0.0 vstep=0.025 vfinal=0.5
log off

# --- Vg = 1.5 V ------------------------------------------------------------
solve name=DRAIN vdrain=0.0
solve name=GATE  vgate=1.0 vstep=0.05 vfinal=1.5
log outfile=gaa_iiiv_hj_tfet_idvd_vg15.log master
solve name=DRAIN vdrain=0.0 vstep=0.025 vfinal=0.5
log off

tonyplot -overlay gaa_iiiv_hj_tfet_idvd_vg05.log \
                  gaa_iiiv_hj_tfet_idvd_vg10.log \
                  gaa_iiiv_hj_tfet_idvd_vg15.log

quit
