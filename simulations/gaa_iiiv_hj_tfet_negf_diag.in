go atlas

#-----------------------------------------------------------------------------
# Diagnostic deck: verify the broken-gap band alignment in the saved
# post-NEGF structure file.
#
# Earlier version of this deck used `save outfile=... sec.x=0.001` to
# write a 1D axial cutline structure for tonyplot. That syntax is meant
# for the in-flight solver and does not work cleanly after a structure
# is reloaded via `mesh infile=`, so the deck errored. This version uses
# `probe` statements instead. probe samples a named field quantity at
# explicit (x,y) coordinates and prints the result to the ATLAS console
# whenever a solve is issued, which is exactly the read-only behaviour
# we want for a diagnostic.
#
# `solve prev` after `mesh infile=` re-evaluates the already-loaded
# bias point without modifying any potential or carrier distribution.
# It exists here only to flush the probe values to the console.
#-----------------------------------------------------------------------------

mesh infile=gaa_iiiv_hj_tfet_negf_btbt_vd05.str

material material=GaSb   permittivity=15.70 eg300=0.726 affinity=4.06 nc300=2.0e17 nv300=1.3e19
material material=InAs   permittivity=15.15 eg300=0.354 affinity=4.90 nc300=8.7e16 nv300=6.6e18
material material=InGaAs permittivity=13.90 eg300=0.74  affinity=4.50 nc300=2.1e17 nv300=7.7e18
material material=HfO2   permittivity=22.0  eg300=5.7   affinity=2.05

output con.band val.band qfn qfp e.field

#-----------------------------------------------------------------------------
# Probe points along the axial cutline at x = 0.001 um (1 nm from the
# cylinder axis, well inside the semiconductor core). Values are printed
# to the ATLAS console when `solve prev` runs below.
#
# Expected values (flat-band, vacuum reference, E = -chi for E_C and
# E = -chi - E_g for E_V):
#   EC_GaSb       = -4.060 eV
#   EV_GaSb       = -4.786 eV
#   EV_GaSb_junc  = -4.786 eV   (just inside GaSb at the junction)
#   EC_InAs_junc  = -4.900 eV   (just inside InAs at the junction)
#   EC_InAs       = -4.900 eV
#   EV_InAs       = -5.254 eV
#   EC_InGaAs     = -4.500 eV
#
# Broken-gap is confirmed when EV_GaSb_junc > EC_InAs_junc, i.e. the
# GaSb valence band sits ABOVE the InAs conduction band by ~114 meV.
# Doping-induced band-bending will shift these values by a few hundred
# meV relative to the flat-band reference, but the relative ordering at
# the junction (VB(GaSb) above CB(InAs)) is what defines Type-III.
#-----------------------------------------------------------------------------
probe name=EC_GaSb       x=0.001 y=0.010 con.band
probe name=EV_GaSb       x=0.001 y=0.010 val.band
probe name=EV_GaSb_junc  x=0.001 y=0.019 val.band
probe name=EC_InAs_junc  x=0.001 y=0.021 con.band
probe name=EC_InAs       x=0.001 y=0.030 con.band
probe name=EV_InAs       x=0.001 y=0.030 val.band
probe name=EC_InGaAs     x=0.001 y=0.050 con.band

# Minimal models / method block. solve prev needs a method definition
# even when no actual stepping is requested. Fermi statistics keeps the
# carrier model consistent with the original NEGF run; classical Newton
# is sufficient because we are not stepping bias.
models fermi temperature=300
method newton

# Re-evaluate at the loaded bias and flush probe values.
solve prev

#-----------------------------------------------------------------------------
# Visual confirmation in tonyplot (optional, gives the full band
# diagram instead of seven point samples):
#   1. tonyplot gaa_iiiv_hj_tfet_negf_btbt_vd05.str
#   2. Plot menu -> Cutline -> Direction=Y, X position=0.001 -> Apply
#   3. Add CON.BAND and VAL.BAND to the plot
#   4. Look for the step at y=0.020 where EC(InAs) drops ~114 meV
#      below EV(GaSb). That is the broken-gap overlap.
#-----------------------------------------------------------------------------
tonyplot gaa_iiiv_hj_tfet_negf_btbt_vd05.str

quit
