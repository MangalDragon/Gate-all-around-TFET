go atlas simflags="-P 4"

#-----------------------------------------------------------------------------
# Gate-All-Around III-V Heterojunction TFET - NEGF Mode-Space version
# Source : GaSb  (p+, broken-gap, PHYSICAL chi=4.06)
# Channel: InAs  (n-, intrinsic)
# Drain  : InGaAs (n+, In0.53Ga0.47As)
# Geometry: Cylindrical, R = 5 nm, Lg = 20 nm, t_OX(HfO2) = 2 nm
#-----------------------------------------------------------------------------
#
# WHAT WE LEARNED FROM THE PREVIOUS RUN (Sat May 23 02:45):
#   - Stage A (DD ramp to V_D=0.5 V) converged cleanly: I_D = 1.72e-14 A.
#   - ATLAS auto-detected cylindrical geometry and selected the 1DX
#     Schrodinger solver, which is correct for a nanowire cross-section.
#   - The band-edge masses ATLAS used for Schrodinger / NEGF (visible in
#     the run log) match accepted literature values:
#         Material  mc        mlh         mhh
#         GaSb      0.039     0.05        0.28
#         InAs      0.026     0.025       0.57
#         InGaAs    0.0412    0.051       0.46
#     Our me.tunnel/mh.tunnel cards are accepted but ATLAS uses its
#     built-in mc/mhh/mlh for Schrodinger and NEGF, which is what we want.
#   - NEGF aborted at the first self-consistent step with the message:
#         "Error in NEGF. Set CARRIERS to 0 on the METHOD statement
#          and try again."
#
# THE FIX (the ONLY functional change vs the prior NEGF deck):
#     carriers=0 on the Stage B and Stage C METHOD statements.
#
#   NEGF computes electron and hole densities itself from the spectral
#   function   n(r,E) = -(i/2pi) [G^< - G^>]
#   so the standard DD continuity equations (carriers=2, the default)
#   conflict with it. carriers=0 turns OFF only the continuity solve;
#   Poisson is still solved, and it couples to the NEGF charge
#   self-consistently. Stage A stays at the default (carriers=2) because
#   that stage is pure DD and needs the continuity equations.
#
# NOTEBOOK FALLBACK TABLE (confirmed against this attempt):
#     BBT.NONLOCAL     - WKB fails on Type-III broken gap
#     SCHENK.BBT       - Si phonon-assisted, not for direct-gap III-V
#     BBT.KL/KANE/STD  - Local, same limit as Hurkx baseline
#     TAT.NONLOCAL     - Removed during cleanup; can revisit on Hurkx deck
#     TRAP.TUNNEL      - Active in working local-Hurkx baseline
#     NEGF_MS/PL1D     - This deck (only blocker was carriers=0)
#     DD_MS            - Cheaper fallback if NEGF is too slow
#     BQP.N/BQP.P      - Already in Hurkx baseline, not stacked on NEGF
#     DGLOG            - Equivalent alternative to BQP (not used)
#
# IF THIS RUN STILL FAILS / IS TOO SLOW:
#     Drop back to gaa_iiiv_hj_tfet.in (verified local-Hurkx baseline,
#     V_T = 1.07 V, SS = 102 mV/dec, I_ON = 2.34 pA), or replace
#     `negf_ms` here with `dd_ms` for a much cheaper sub-band run.
#-----------------------------------------------------------------------------

set Lg = 0.020
set R = 0.005
set tOX = 0.002
set tGate = 0.002
set Lds = 0.020
set doping_src = 5e19
set doping_drn = 5e19
set doping_ch = 1e15
set gate_wf = 5.20
set Ychar = 0.001

# Physical broken-gap alignment (no Type-II shift kludge).
# NEGF handles Type-III natively; the WKB integrator could not.
set gasb_chi = 4.06

#-----------------------------------------------------------------------------
# Mesh - cylindrical, no QTX/QTY (NEGF uses the regular mesh; energy
# grid is internal and controlled by ESIZE.NEGF below).
#-----------------------------------------------------------------------------
MESH CYLINDRICAL

X.MESH loc=0.000   spacing=0.0010
X.MESH loc=0.003   spacing=0.0005
X.MESH loc=0.0045  spacing=0.0002
X.MESH loc=0.005   spacing=0.0001
X.MESH loc=0.006   spacing=0.0001
X.MESH loc=0.007   spacing=0.0001
X.MESH loc=0.008   spacing=0.0005
X.MESH loc=0.009   spacing=0.0010

Y.MESH loc=0.000   spacing=0.005
Y.MESH loc=0.003   spacing=0.001
Y.MESH loc=0.015   spacing=0.0005
Y.MESH loc=0.018   spacing=0.0002
Y.MESH loc=0.0195  spacing=0.0001
Y.MESH loc=0.020   spacing=0.0001
Y.MESH loc=0.0205  spacing=0.0001
Y.MESH loc=0.022   spacing=0.0002
Y.MESH loc=0.025   spacing=0.0005
Y.MESH loc=0.030   spacing=0.0010
Y.MESH loc=0.035   spacing=0.0010
Y.MESH loc=0.0395  spacing=0.0001
Y.MESH loc=0.040   spacing=0.0001
Y.MESH loc=0.043   spacing=0.0005
Y.MESH loc=0.057   spacing=0.001
Y.MESH loc=0.060   spacing=0.005

REGION NUM=1 NAME=SRC_GaSb    MATERIAL=GaSb   Y.MIN=0.003 Y.MAX=0.020 X.MIN=0 X.MAX=0.005
REGION NUM=2 NAME=CH_InAs     MATERIAL=InAs   Y.MIN=0.020 Y.MAX=0.040 X.MIN=0 X.MAX=0.005
REGION NUM=3 NAME=DRN_InGaAs  MATERIAL=InGaAs Y.MIN=0.040 Y.MAX=0.057 X.MIN=0 X.MAX=0.005
REGION NUM=4 NAME=GATE_OX     MATERIAL=HfO2   Y.MIN=0.020 Y.MAX=0.040 X.MIN=0.005 X.MAX=0.007
REGION NUM=5 MATERIAL=Air Y.MIN=0.000 Y.MAX=0.020 X.MIN=0.005 X.MAX=0.009
REGION NUM=6 MATERIAL=Air Y.MIN=0.040 Y.MAX=0.060 X.MIN=0.005 X.MAX=0.009

ELECTRODE NAME=SOURCE MATERIAL=Aluminum Y.MIN=0.000 Y.MAX=0.003 X.MIN=0 X.MAX=0.005
ELECTRODE NAME=DRAIN  MATERIAL=Aluminum Y.MIN=0.057 Y.MAX=0.060 X.MIN=0 X.MAX=0.005
ELECTRODE NAME=GATE   MATERIAL=Aluminum Y.MIN=0.020 Y.MAX=0.040 X.MIN=0.007 X.MAX=0.009

DOPING GAUSSIAN MATERIAL=GaSb   P.TYPE CONCENTRATION=$doping_src Y.MIN=0.003 Y.MAX=0.020 X.MAX=0.005 Y.CHAR=$Ychar X.CHAR=0
DOPING UNIFORM  MATERIAL=InAs   N.TYPE CONCENTRATION=$doping_ch  Y.MIN=0.020 Y.MAX=0.040 X.MAX=0.005
DOPING GAUSSIAN MATERIAL=InGaAs N.TYPE CONCENTRATION=$doping_drn Y.MIN=0.045 Y.MAX=0.060 X.MAX=0.005 Y.CHAR=0.002 X.CHAR=0

#-----------------------------------------------------------------------------
# Materials
# me.tunnel / mh.tunnel are kept (they avoid the "ambiguous parameter"
# error that bare me=/mh= produced in earlier iterations). NEGF and
# Schrodinger ignore them and use the built-in mc/mhh/mlh, which the
# previous run log confirmed are correct.
#-----------------------------------------------------------------------------
material material=InAs   permittivity=15.15 eg300=0.354 affinity=4.90 nc300=8.7e16 nv300=6.6e18 \
  me.tunnel=0.023 mh.tunnel=0.026 \
  mun=20000 mup=500 taun0=1e-7 taup0=1e-7

material material=GaSb   permittivity=15.70 eg300=0.726 affinity=$gasb_chi nc300=2.0e17 nv300=1.3e19 \
  me.tunnel=0.039 mh.tunnel=0.05 \
  mun=3000 mup=1000 taun0=1e-7 taup0=1e-7

material material=InGaAs permittivity=13.90 eg300=0.74 affinity=4.50 nc300=2.1e17 nv300=7.7e18 \
  me.tunnel=0.041 mh.tunnel=0.050 \
  mun=12000 mup=300 taun0=1e-7 taup0=1e-7

material material=HfO2 permittivity=22.0 eg300=5.7 affinity=2.05

contact name=SOURCE
contact name=DRAIN
contact name=GATE workfunc=$gate_wf

interface x.min=0.005 x.max=0.005 y.min=0.020 y.max=0.040 s.n=5e2 s.p=5e2

output band.param qfn qfp j.electron j.hole j.total con.band val.band e.field flowlines

#=============================================================================
# STAGE A : DD only, ramp V_D to 0.5 V (initial guess for NEGF)
#   carriers default = 2 (electron + hole continuity equations on).
#   bgn included for accuracy in heavily-doped source/drain.
#=============================================================================
models fermi srh auger fldmob conmob bgn temperature=300 print
method gummel newton autonr trap maxtrap=10 itlimit=50 climit=1e-5 dvmax=0.5

solve init
save outfile=gaa_iiiv_hj_tfet_negf_eq.str

solve name=DRAIN vdrain=0.0 vstep=0.05 vfinal=0.5
save outfile=gaa_iiiv_hj_tfet_negf_dd_vd05.str

#=============================================================================
# STAGE B : enable NEGF Mode-Space at V_D = 0.5 V
#   *** carriers=0 is THE FIX for the previous run's abort. ***
#   NEGF replaces continuity; Poisson still couples self-consistently.
#=============================================================================
models negf_ms schrodinger eigen=8 esize.negf=200 npred.negf=10 \
       fermi srh auger conmob temperature=300 print

method newton autonr trap maxtrap=20 itlimit=80 climit=1e-5 dvmax=0.05 \
       carriers=0

solve prev
save outfile=gaa_iiiv_hj_tfet_negf_btbt_vd05.str

#=============================================================================
# STAGE C : transfer curve Id-Vg at V_DS = 0.5 V (NEGF stays active,
# carriers=0 carries forward to keep continuity off).
#=============================================================================
method newton autonr trap maxtrap=30 itlimit=100 climit=1e-5 dvmax=0.1 \
       carriers=0

solve name=GATE vgate=0.0 vstep=-0.025 vfinal=-0.5

log outfile=gaa_iiiv_hj_tfet_negf_idvg.log master
solve name=GATE vgate=-0.5 vstep=0.025 vfinal=1.0
log off

save outfile=gaa_iiiv_hj_tfet_negf_on.str

tonyplot gaa_iiiv_hj_tfet_negf_idvg.log
tonyplot -st gaa_iiiv_hj_tfet_negf_idvg.log -set log10y

extract init infile="gaa_iiiv_hj_tfet_negf_idvg.log"
extract name="V_T_n_TFET_NEGF" xintercept(maxslope(curve(abs(v."gate"), abs(i."drain"))))
extract name="SS_NEGF_mVdec"   1000.0/slope(maxslope(curve(abs(v."gate"), log10(abs(i."drain")))))

quit
