go atlas simflags="-P 4"

# Gate-All-Around III-V Heterojunction TFET - NEGF MODE-SPACE VERSION
# Source : GaSb  (p+, broken-gap, PHYSICAL chi=4.06)
# Channel: InAs  (n-, intrinsic)
# Drain  : InGaAs (n+, In0.53Ga0.47As)
# Geometry: Cylindrical, R = 5 nm, Lg = 20 nm, t_OX(HfO2) = 2 nm
#
# I owe the user another correction: I claimed NEGF was unavailable in
# ATLAS 2019 and that NEGF-grade physics required Nemo5/OMEN/Sentaurus.
# The user pointed out that QUANTUM is enabled in their license (as
# their initial license output confirmed) and provided the manual
# section for NEGF_MS, NEGF_CMS, NEGF_UMS, NEGF_PL1D, NEGF_PL.
#
# This is the right tool for this device. Mode-Space NEGF was designed
# for exactly this case: cylindrical nanowire with strong transverse
# confinement. Avci 2015 used the same methodology to simulate the
# GaSb/InAs/InGaAs broken-gap GAA TFET we are modeling.
#
# Why NEGF solves the broken-gap problem that BBT.NONLOCAL could not:
#   BBT.NONLOCAL evaluates the WKB transmission
#       T(E) ~ exp(-2 integral sqrt(2m(V(x)-E)/hbar^2) dx)
#   which requires a forbidden barrier V(x)-E > 0 along the path.
#   For Type-III broken gap (E_V(GaSb) > E_C(InAs)), the radicand goes
#   negative and ATLAS throws Code 2.
#
#   NEGF solves directly:
#       G^R(E) = [E*I - H - Sigma^R(E)]^(-1)
#       T(E)   = Tr(Gamma_S G^R Gamma_D G^A)
#   No barrier assumption. Works for any band alignment, including
#   broken gap. This is the physically-correct treatment.
#
# Trade-offs vs the local-Hurkx baseline (gaa_iiiv_hj_tfet.in):
#   Pros:
#     - Proper quantum transport, no empirical bbt.a/bbt.b fitting
#     - Handles broken-gap (no band-shift kludge needed -> chi=4.06)
#     - Captures sub-band quantization in the 5 nm nanowire
#     - I_ON should reach the realistic uA range (Avci 2015 territory)
#     - Sub-thermal SS is achievable (no thermal-tail floor like
#       drift-diffusion + Hurkx)
#   Cons:
#     - SLOW. NEGF inverts (E*I - H - Sigma) at each energy point at
#       every Newton iteration. Expect HOURS per run, not minutes.
#     - May not converge first try. Predictor-corrector iterations
#       (NPRED.NEGF) and energy grid (ESIZE.NEGF) may need tuning.
#     - Effective-mass NEGF is single-band; for true broken-gap
#       quantum mechanics you ideally want k.p or full-band atomistic
#       (Nemo5/OMEN). NEGF_MS in ATLAS gets you closer than BBT but
#       not all the way to publication-grade.
#
# Strategy:
#   Stage A: DD-only, ramp V_D to 0.5 V (provides initial guess).
#   Stage B: enable NEGF_MS at V_D=0.5 V, solve self-consistent.
#   Stage C: V_G sweep with NEGF on, log Id-Vg.
#   Stage D: Id-Vd family (deferred; can be added once Stage C works).
#
# IF NEGF DOES NOT CONVERGE OR IS TOO SLOW:
#   The local-Hurkx deck (gaa_iiiv_hj_tfet.in) remains our verified
#   working baseline at V_T=1.07 V, SS=102 mV/dec, I_ON=2.34 pA.

set Lg = 0.020
set R = 0.005
set tOX = 0.002
set tGate = 0.002
set Lds = 0.020
set doping_src = 5e19
set doping_drn = 5e19
set doping_ch = 1e15
set gate_wf = 5.20
set Ychar = 0.001

# PHYSICAL band alignment - no kludge needed for NEGF.
# The Type-III broken-gap junction is what NEGF handles natively.
set gasb_chi = 4.06

MESH CYLINDRICAL

X.MESH loc=0.000   spacing=0.0010
X.MESH loc=0.003   spacing=0.0005
X.MESH loc=0.0045  spacing=0.0002
X.MESH loc=0.005   spacing=0.0001
X.MESH loc=0.006   spacing=0.0001
X.MESH loc=0.007   spacing=0.0001
X.MESH loc=0.008   spacing=0.0005
X.MESH loc=0.009   spacing=0.0010

Y.MESH loc=0.000   spacing=0.005
Y.MESH loc=0.003   spacing=0.001
Y.MESH loc=0.015   spacing=0.0005
Y.MESH loc=0.018   spacing=0.0002
Y.MESH loc=0.0195  spacing=0.0001
Y.MESH loc=0.020   spacing=0.0001
Y.MESH loc=0.0205  spacing=0.0001
Y.MESH loc=0.022   spacing=0.0002
Y.MESH loc=0.025   spacing=0.0005
Y.MESH loc=0.030   spacing=0.0010
Y.MESH loc=0.035   spacing=0.0010
Y.MESH loc=0.0395  spacing=0.0001
Y.MESH loc=0.040   spacing=0.0001
Y.MESH loc=0.043   spacing=0.0005
Y.MESH loc=0.057   spacing=0.001
Y.MESH loc=0.060   spacing=0.005

# NEGF does NOT use the qtx.mesh / qty.mesh that BBT.NONLOCAL uses.
# Schrodinger sub-band calculation uses the regular X.MESH for the
# transverse direction. NEGF transport calculation uses the regular
# Y.MESH for the axial direction. The energy grid is internal to NEGF
# (controlled by ESIZE.NEGF on the models statement).

REGION NUM=1 NAME=SRC_GaSb    MATERIAL=GaSb   Y.MIN=0.003 Y.MAX=0.020 X.MIN=0 X.MAX=0.005
REGION NUM=2 NAME=CH_InAs     MATERIAL=InAs   Y.MIN=0.020 Y.MAX=0.040 X.MIN=0 X.MAX=0.005
REGION NUM=3 NAME=DRN_InGaAs  MATERIAL=InGaAs Y.MIN=0.040 Y.MAX=0.057 X.MIN=0 X.MAX=0.005
REGION NUM=4 NAME=GATE_OX     MATERIAL=HfO2   Y.MIN=0.020 Y.MAX=0.040 X.MIN=0.005 X.MAX=0.007
REGION NUM=5 MATERIAL=Air Y.MIN=0.000 Y.MAX=0.020 X.MIN=0.005 X.MAX=0.009
REGION NUM=6 MATERIAL=Air Y.MIN=0.040 Y.MAX=0.060 X.MIN=0.005 X.MAX=0.009

ELECTRODE NAME=SOURCE MATERIAL=Aluminum Y.MIN=0.000 Y.MAX=0.003 X.MIN=0 X.MAX=0.005
ELECTRODE NAME=DRAIN  MATERIAL=Aluminum Y.MIN=0.057 Y.MAX=0.060 X.MIN=0 X.MAX=0.005
ELECTRODE NAME=GATE   MATERIAL=Aluminum Y.MIN=0.020 Y.MAX=0.040 X.MIN=0.007 X.MAX=0.009

DOPING GAUSSIAN MATERIAL=GaSb   P.TYPE CONCENTRATION=$doping_src Y.MIN=0.003 Y.MAX=0.020 X.MAX=0.005 Y.CHAR=$Ychar X.CHAR=0
DOPING UNIFORM  MATERIAL=InAs   N.TYPE CONCENTRATION=$doping_ch  Y.MIN=0.020 Y.MAX=0.040 X.MAX=0.005
DOPING GAUSSIAN MATERIAL=InGaAs N.TYPE CONCENTRATION=$doping_drn Y.MIN=0.045 Y.MAX=0.060 X.MAX=0.005 Y.CHAR=0.002 X.CHAR=0

# Material cards. CRITICAL for NEGF:
#   - PHYSICAL band alignment (no Type-II kludge): GaSb chi=4.06
#   - Effective masses (me, mh) drive the Schrodinger sub-band calc.
#     These are the BAND-EDGE masses, distinct from me.tunnel/mh.tunnel
#     used by the local BBT models.
#   - GaSb mh = 0.05 (light hole, dominates BTBT) not 0.40 (heavy).
material material=InAs   permittivity=15.15 eg300=0.354 affinity=4.90 nc300=8.7e16 nv300=6.6e18 \
  me.tunnel=0.023 mh.tunnel=0.026 \
  mun=20000 mup=500 taun0=1e-7 taup0=1e-7

material material=GaSb   permittivity=15.70 eg300=0.726 affinity=$gasb_chi nc300=2.0e17 nv300=1.3e19 \
  me.tunnel=0.039 mh.tunnel=0.05 \
  mun=3000 mup=1000 taun0=1e-7 taup0=1e-7

material material=InGaAs permittivity=13.90 eg300=0.74 affinity=4.50 nc300=2.1e17 nv300=7.7e18 \
  me.tunnel=0.041 mh.tunnel=0.050 \
  mun=12000 mup=300 taun0=1e-7 taup0=1e-7

material material=HfO2 permittivity=22.0 eg300=5.7 affinity=2.05

contact name=SOURCE
contact name=DRAIN
contact name=GATE workfunc=$gate_wf

interface x.min=0.005 x.max=0.005 y.min=0.020 y.max=0.040 s.n=5e2 s.p=5e2

output band.temp band.param qfn qfp j.electron j.hole j.total con.band val.band e.mobility e.field flowlines

# ===== STAGE A: DD only, ramp V_D to 0.5 V =====
# DD provides the self-consistent initial guess for NEGF.
models fermi srh auger fldmob conmob bgn temperature=300 print
method gummel newton autonr trap maxtrap=10 itlimit=50 climit=1e-5 dvmax=0.5

solve init
save outfile=gaa_iiiv_hj_tfet_negf_eq.str

solve name=DRAIN vdrain=0.0 vstep=0.05 vfinal=0.5
save outfile=gaa_iiiv_hj_tfet_negf_dd_vd05.str

# ===== STAGE B: enable NEGF Mode-Space at V_D=0.5 V =====
# NEGF_MS      : Mode-Space NEGF, lets ATLAS auto-pick CMS vs UMS.
#                For broken-gap with band mixing, it should select CMS.
#                If ATLAS sticks with UMS and currents are too low,
#                replace NEGF_MS with NEGF_CMS to force coupled modes.
# SCHRODINGER  : compute the transverse sub-bands at each axial slice
#                (required by NEGF_MS).
# EIGEN=8      : keep 8 sub-bands per valley. For 5 nm radius nanowire
#                this captures the lowest few transport modes adequately.
#                Increase to 12-16 if results look quantization-limited.
# ESIZE.NEGF=200 : 200 energy grid points. Default may be too coarse
#                for the sharp BTBT onset; 200 is a reasonable starting
#                point. Increase to 400 if the Id-Vg looks step-like.
# NPRED.NEGF=10: 10 predictor iterations (default 7). More predictors
#                help when Poisson and NEGF are far from self-consistent.
models negf_ms schrodinger eigen=8 esize.negf=200 npred.negf=10 \
       fermi srh auger conmob bgn temperature=300 print

method newton autonr trap maxtrap=20 itlimit=80 climit=1e-5 dvmax=0.05 carriers=0

solve prev
save outfile=gaa_iiiv_hj_tfet_negf_btbt_vd05.str

# ===== STAGE C: transfer curve Id-Vg at V_DS = 0.5 V =====
# Tighter V_G range than the BBT versions: NEGF is slow, so we limit
# the sweep to -0.5 to +1.0 V (60 points). With NEGF predicting a
# proper V_T near 0.3-0.5 V, this range covers I_OFF -> I_ON cleanly.
# Extend later if needed.
solve name=GATE vgate=0.0 vstep=-0.025 vfinal=-0.5

log outfile=gaa_iiiv_hj_tfet_negf_idvg.log master
solve name=GATE vgate=-0.5 vstep=0.025 vfinal=1.0
log off

save outfile=gaa_iiiv_hj_tfet_negf_on.str

tonyplot gaa_iiiv_hj_tfet_negf_idvg.log
tonyplot -st gaa_iiiv_hj_tfet_negf_idvg.log -set log10y

# Extract V_T (max-slope x-intercept) and SS (1/max-slope of log10|Id|).
extract init infile="gaa_iiiv_hj_tfet_negf_idvg.log"
extract name="V_T_n_TFET_NEGF" xintercept(maxslope(curve(abs(v."gate"), abs(i."drain"))))
extract name="SS_NEGF_mVdec"   1000.0/slope(maxslope(curve(abs(v."gate"), log10(abs(i."drain")))))

# ===== STAGE D: deferred =====
# Id-Vd family is intentionally NOT included on the first NEGF run.
# Each I-V point under NEGF takes 10-100x longer than under DD; running
# 3 full Id-Vd sweeps on top of the Id-Vg would push the total runtime
# into many hours. Once Stage C converges and you confirm a sensible
# Id-Vg, add Stage D in a follow-up commit.

quit
