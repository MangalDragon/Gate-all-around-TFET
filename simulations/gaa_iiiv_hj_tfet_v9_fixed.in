#-----------------------------------------------------------------------------
# v9 deck with the bugs that ACTUALLY exist in the original v9 fixed,
# plus the structural improvements needed to make it actually run on
# this broken-gap structure.
#
# Bug audit vs the prompt's claim list, against simulations/original_v9.in:
#
#   [Claim 1] "bbt.kane should be bbt.nonlocal"
#     -> The committed original_v9.in uses bbt.nonlocal already; no
#        replacement was needed in the repo file. (If your local copy
#        of v9 has bbt.kane, this fix does apply there.)
#
#   [Claim 2] "Two models lines on separate lines overwrite each other"
#     -> The committed original_v9.in has a single multi-line models
#        statement using backslash continuations, so no overwrite bug
#        in the repo file. The rule remains correct in general.
#
#   [Claim 3] "IdVg plotted on linear scale only"  -> TRUE, fixed below.
#   [Claim 4] "IdVd has unclear gate bias state"   -> TRUE, fixed below.
#   [Claim 5] "u.bbt not in output statement"      -> TRUE, fixed below.
#
# Structural improvements added (the prompt's "Code 2 cannot produce
# useful results" feedback):
#
#   - Two-stage solve. v9 went straight to `solve init` with full
#     physics active, which is the documented Gummel-divergence failure
#     mode for broken-gap structures. Now we do DD-only init first,
#     then turn BTBT/TAT/BQP on and warm-start with `solve prev`.
#
#   - BQP added (Bohm Quantum Potential) on n and p. Without it the
#     5 nm radius sub-band shift (~150-250 meV) is missing and V_T /
#     I_ON come out wrong.
#
#   - Gate sweep extended from V_G = -0.5 V to +1.5 V instead of 0
#     to 1.5. The device is naturally p-branch dominant at gate_wf =
#     4.35 eV (broken-gap is open at V_G < 0); starting at V_G = 0
#     misses the entire dominant operating branch.
#
#   - method climit tightened from 1e-4 to 1e-5; autonr added.
#
#   - extract block writes V_T, SS, I_ON, I_OFF as named values to
#     the runtime log.
#-----------------------------------------------------------------------------
go atlas

set Lg         = 0.020
set R          = 0.005
set tOX        = 0.002
set tGate      = 0.002
set Lds        = 0.020
set doping_src = 5e19
set doping_drn = 5e19
set doping_ch  = 1e15
set gate_wf    = 4.35
set Ychar      = 0.003

MESH CYLINDRICAL

X.MESH loc=0.000   spacing=0.0010
X.MESH loc=0.003   spacing=0.0005
X.MESH loc=0.0045  spacing=0.0002
X.MESH loc=0.005   spacing=0.0001
X.MESH loc=0.006   spacing=0.0001
X.MESH loc=0.007   spacing=0.0001
X.MESH loc=0.008   spacing=0.0005
X.MESH loc=0.009   spacing=0.0010

Y.MESH loc=0.000   spacing=0.005
Y.MESH loc=0.003   spacing=0.001
Y.MESH loc=0.017   spacing=0.0005
Y.MESH loc=0.0195  spacing=0.0001
Y.MESH loc=0.020   spacing=0.0001
Y.MESH loc=0.025   spacing=0.0010
Y.MESH loc=0.030   spacing=0.0010
Y.MESH loc=0.035   spacing=0.0010
Y.MESH loc=0.0395  spacing=0.0001
Y.MESH loc=0.040   spacing=0.0001
Y.MESH loc=0.043   spacing=0.0005
Y.MESH loc=0.057   spacing=0.001
Y.MESH loc=0.060   spacing=0.005

QTX.MESH LOC=0.000 SPACING=0.001
QTX.MESH LOC=0.005 SPACING=0.001

QTY.MESH LOC=0.015 SPACING=0.0005
QTY.MESH LOC=0.020 SPACING=0.0001
QTY.MESH LOC=0.025 SPACING=0.0005

REGION NUM=1 NAME=SRC_GaSb    MATERIAL=GaSb   Y.MIN=0.003 Y.MAX=0.020 X.MIN=0 X.MAX=0.005
REGION NUM=2 NAME=CH_InAs     MATERIAL=InAs   Y.MIN=0.020 Y.MAX=0.040 X.MIN=0 X.MAX=0.005
REGION NUM=3 NAME=DRN_InGaAs  MATERIAL=InGaAs Y.MIN=0.040 Y.MAX=0.057 X.MIN=0 X.MAX=0.005
REGION NUM=4 NAME=GATE_OX     MATERIAL=HfO2   Y.MIN=0.020 Y.MAX=0.040 X.MIN=0.005 X.MAX=0.007
REGION NUM=5 MATERIAL=Air Y.MIN=0.000 Y.MAX=0.020 X.MIN=0.005 X.MAX=0.009
REGION NUM=6 MATERIAL=Air Y.MIN=0.040 Y.MAX=0.060 X.MIN=0.005 X.MAX=0.009

ELECTRODE NAME=SOURCE MATERIAL=Aluminum Y.MIN=0.000 Y.MAX=0.003 X.MIN=0 X.MAX=0.005
ELECTRODE NAME=DRAIN  MATERIAL=Aluminum Y.MIN=0.057 Y.MAX=0.060 X.MIN=0 X.MAX=0.005
ELECTRODE NAME=GATE   MATERIAL=Aluminum Y.MIN=0.020 Y.MAX=0.040 X.MIN=0.007 X.MAX=0.009

DOPING GAUSSIAN MATERIAL=GaSb P.TYPE CONCENTRATION=$doping_src \
  Y.MIN=0.003 Y.MAX=0.020 X.MAX=0.005 Y.CHAR=$Ychar X.CHAR=0
DOPING UNIFORM  MATERIAL=InAs N.TYPE CONCENTRATION=$doping_ch \
  Y.MIN=0.020 Y.MAX=0.040 X.MAX=0.005
DOPING GAUSSIAN MATERIAL=InGaAs N.TYPE CONCENTRATION=$doping_drn \
  Y.MIN=0.040 Y.MAX=0.060 X.MAX=0.005 Y.CHAR=$Ychar X.CHAR=0

material material=InAs permittivity=15.15 \
  eg300=0.354 affinity=4.90 nc300=8.7e16 nv300=6.6e18 \
  me.tunnel=0.023 mh.tunnel=0.026 \
  bbt.a=4.0e14 bbt.b=1.9e7 \
  taun0=1e-9 taup0=1e-9 \
  vsatn=4.0e7 vsatp=4.0e7

material material=GaSb permittivity=15.70 \
  eg300=0.726 affinity=4.06 nc300=2.0e17 nv300=1.3e19 \
  me.tunnel=0.039 mh.tunnel=0.40 \
  bbt.a=9.1e14 bbt.b=1.3e7 \
  taun0=1e-9 taup0=1e-9 \
  vsatn=7.0e6 vsatp=7.0e6

material material=InGaAs permittivity=13.90 \
  eg300=0.74 affinity=4.50 nc300=2.1e17 nv300=7.7e18 \
  me.tunnel=0.041 mh.tunnel=0.050 \
  taun0=1e-9 taup0=1e-9 \
  vsatn=2.5e7 vsatp=2.5e7

material material=HfO2 permittivity=21.0

contact name=SOURCE
contact name=DRAIN
contact name=GATE workfunc=$gate_wf

interface x.min=0.005 x.max=0.005 y.min=0.020 y.max=0.040 s.n=5e2 s.p=5e2

# *** FIX 5: u.bbt added to output ***
output band.temp band.param  \
  qfn qfp                    \
  j.electron j.hole j.total  \
  con.band val.band          \
  e.mobility e.field         \
  u.bbt u.srh                \
  flowlines

#-----------------------------------------------------------------------------
# Stage A: DD-only equilibrium (no BTBT/TAT/BQP yet).
#   This avoids the Gummel divergence at solve init that plagues
#   broken-gap structures when full physics is on from the start.
#-----------------------------------------------------------------------------
models                              \
  fermi ni.fermi                    \
  srh auger                         \
  fldmob conmob bgn                 \
  temperature=300                   \
  print

method gummel newton autonr trap maxtrap=10 itlimit=50 climit=1e-5 dvmax=0.5

solve init
save outfile=gaa_iiiv_hj_tfet_v9_eq_DD.str

#-----------------------------------------------------------------------------
# Stage B: turn on full TFET physics (BTBT + TAT + BQP) and warm-start
#   from the DD solution. bqp.n / bqp.p activate the Bohm Quantum
#   Potential separately for electrons and holes.
#-----------------------------------------------------------------------------
models                              \
  bbt.nonlocal                      \
  tat                               \
  bqp                               \
  fermi ni.fermi                    \
  srh auger                         \
  fldmob conmob bgn                 \
  temperature=300                   \
  print

# BQP calibration constants (Silvaco BQP application note defaults)
material material=InAs   gamma.n=1.4 alpha.n=0.3 gamma.p=1.4 alpha.p=0.3
material material=GaSb   gamma.n=1.4 alpha.n=0.3 gamma.p=1.4 alpha.p=0.3
material material=InGaAs gamma.n=1.4 alpha.n=0.3 gamma.p=1.4 alpha.p=0.3

method newton autonr trap maxtrap=30 itlimit=100 climit=1e-5 dvmax=0.2

solve prev
save outfile=gaa_iiiv_hj_tfet_v9_eq.str
tonyplot gaa_iiiv_hj_tfet_v9_eq.str

# Drain ramp first
solve name=DRAIN vdrain=0.0 vstep=0.05 vfinal=0.5

# Gate sweep covers V_G = -0.5 V (p-branch) through +1.5 V (n-branch).
# At gate_wf = 4.35 eV the broken-gap is naturally open at V_G < 0,
# so the dominant current is the p-branch; we need both branches in
# the log to see the full ambipolar curve.
log outfile=gaa_iiiv_hj_tfet_v9_idvg.log master
solve name=GATE vgate=0.0 vstep=-0.025 vfinal=-0.5
solve name=GATE vgate=-0.5 vstep=0.025 vfinal=1.5
log off

save outfile=gaa_iiiv_hj_tfet_v9_on.str

# *** FIX 3: linear AND log-scale tonyplot of IdVg ***
# (If your tonyplot rejects -set log10y, open the .log interactively and
#  use Display -> Y Logarithmic to switch to log scale.)
tonyplot gaa_iiiv_hj_tfet_v9_idvg.log
tonyplot -st gaa_iiiv_hj_tfet_v9_idvg.log -set log10y

# *** FIX (extra): extract V_T, SS, I_ON from the IdVg log ***
# Using min(dydx(...)) for SS instead of slope(maxslope(...)) - the
# dydx form parses cleanly across all 2019 builds.
extract init infile="gaa_iiiv_hj_tfet_v9_idvg.log"
extract name="V_T_v9"        xintercept(maxslope(curve(abs(v."gate"), abs(i."drain"))))
extract name="SS_v9_mVdec"   min(dydx(v."gate", log10(abs(i."drain")))) * 1000.0
extract name="I_ON_v9"       max(abs(i."drain"))
extract name="I_OFF_v9_min"  min(abs(i."drain"))

# *** FIX 4: IdVd sweeps with explicit gate-bias reset between stages ***
# Each VG point starts from a fresh solve init, then ramps cleanly to the
# target VG with VD = 0, then sweeps VD up.

# --- Vg = 0.5 V ---
solve init
solve name=DRAIN vdrain=0.0
solve name=GATE  vgate=0.0 vstep=0.1 vfinal=0.5
log outfile=idvd_vg05.log master
solve name=DRAIN vdrain=0.0 vstep=0.025 vfinal=0.5
log off

# --- Vg = 1.0 V (explicit reset) ---
solve init
solve name=DRAIN vdrain=0.0
solve name=GATE  vgate=0.0 vstep=0.1 vfinal=1.0
log outfile=idvd_vg10.log master
solve name=DRAIN vdrain=0.0 vstep=0.025 vfinal=0.5
log off

# --- Vg = 1.5 V (explicit reset) ---
solve init
solve name=DRAIN vdrain=0.0
solve name=GATE  vgate=0.0 vstep=0.1 vfinal=1.5
log outfile=idvd_vg15.log master
solve name=DRAIN vdrain=0.0 vstep=0.025 vfinal=0.5
log off

tonyplot -overlay idvd_vg05.log idvd_vg10.log idvd_vg15.log

quit
